<%- include('partials/header') %>

<%
  const totalKcal = journal.reduce((sum, j) => sum + Number(j.calories_calc), 0);
  const totalGlucides = journal.reduce((sum, j) => sum + Number(j.glucides_calc), 0);
  const totalProteines = journal.reduce((sum, j) => sum + Number(j.proteines_calc), 0);
  const totalLipides = journal.reduce((sum, j) => sum + Number(j.lipides_calc), 0);
  const alimentsTries = [...aliments].sort((a, b) => a.nom.localeCompare(b.nom));
  // Ensemble fixe plutôt que déduit des recettes existantes, sinon une catégorie sans recette n'aurait jamais sa section.
  const CATEGORIES_RECETTE = [
    { valeur: "plat", label: "Plats" },
    { valeur: "fraicheur", label: "Fraîcheur" }
  ];
%>

<main>
  <div class="journal-section">
    <h1>Compter sans <span>culpabiliser.</span></h1>
    <p class="page-header__description">Chaque bouchée a le droit d'être notée — sauf la troisième part de gâteau, on garde un œil dessus.</p>

    <!-- Les id (totalKcal, etc.) permettent à calories.js de mettre ces totaux à jour en direct. -->
    <div class="journal-totaux">
      <div class="macro-card macro-calories">
        <span class="macro-valeur" id="totalKcal"><%= totalKcal.toFixed(0) %></span>
        <span class="macro-label">kcal</span>
      </div>
      <div class="macro-card">
        <span class="macro-valeur" id="totalGlucides"><%= totalGlucides.toFixed(1) %>g</span>
        <span class="macro-label">Glucides</span>
      </div>
      <div class="macro-card">
        <span class="macro-valeur" id="totalProteines"><%= totalProteines.toFixed(1) %>g</span>
        <span class="macro-label">Protéines</span>
      </div>
      <div class="macro-card">
        <span class="macro-valeur" id="totalLipides"><%= totalLipides.toFixed(1) %>g</span>
        <span class="macro-label">Lipides</span>
      </div>
    </div>

    <!-- Journal et Recettes : deux onglets d'une même page, changer d'onglet ne recharge rien (voir calories.js). -->
    <div class="calories-tabs">
      <button type="button" class="calories-tab-btn actif" data-tab="journal">Journal</button>
      <button type="button" class="calories-tab-btn" data-tab="recettes">Recettes</button>
    </div>

    <!-- ============================================ -->
    <!-- ONGLET JOURNAL -->
    <!-- ============================================ -->
    <div class="calories-tab-panel actif" data-panel="journal">

      <div class="journal-actions-row">
        <div id="autocompleteCalories">
          <div class="champ-recherche-wrapper">
            <input type="text" id="rechercheAlimentCalories" placeholder="Rechercher un aliment..." autocomplete="off" />
            <button type="button" class="btn-effacer-recherche" data-cible="rechercheAlimentCalories" aria-label="Effacer la recherche"></button>
          </div>
          <ul id="listeAlimentsCalories">
            <% aliments.forEach(function(aliment) { %>
            <li data-id="<%= aliment.id %>">
              <%= aliment.emoji %> <%= aliment.nom %>
            </li>
            <% }) %>
          </ul>
        </div>

        <!-- Applique une recette de plat au journal ; aria-label compense l'icône seule, sans texte (voir custom-selects.js). -->
        <% const recettesPlat = recettes.filter(function(r) { return r.categorie === 'plat'; }).sort(function(a, b) { return a.nom.localeCompare(b.nom); }); %>
        <select id="selectRecettePlat" aria-label="Remplacer le journal du jour avec une recette" <%= recettesPlat.length === 0 ? 'disabled title="Aucune recette de plat pour le moment"' : '' %>>
          <option value=""><%= recettesPlat.length === 0 ? 'Aucune recette de plat' : '' %></option>
          <% recettesPlat.forEach(function(recette) { %>
          <option value="<%= recette.id %>"><%= recette.nom %></option>
          <% }) %>
        </select>

        <!-- Même principe que #selectRecettePlat, pour "Fraîcheur" (boissons + glaces). -->
        <% const recettesFraicheur = recettes.filter(function(r) { return r.categorie === 'fraicheur'; }).sort(function(a, b) { return a.nom.localeCompare(b.nom); }); %>
        <select id="selectRecetteFraicheur" aria-label="Remplacer le journal du jour avec une recette de fraîcheur" <%= recettesFraicheur.length === 0 ? 'disabled title="Aucune recette de fraîcheur pour le moment"' : '' %>>
          <option value=""><%= recettesFraicheur.length === 0 ? 'Aucune recette de fraîcheur' : '' %></option>
          <% recettesFraicheur.forEach(function(recette) { %>
          <option value="<%= recette.id %>"><%= recette.nom %></option>
          <% }) %>
        </select>

        <button type="button" id="btnToutEffacer" class="btn-x-rond" title="Tout effacer">Tout effacer</button>
      </div>

      <!-- Visible seulement si le journal a 3+ aliments et que cette combinaison n'a pas déjà de recette (voir calories.js). -->
      <button type="button" id="btnEnregistrerRecette" class="btn-enregistrer-recette hidden"></button>

      <div id="listeJournal">
        <% journal.forEach(function(entree) { %>
        <%
          // "0.00" (NUMERIC en texte) est "vrai" en JS : parseFloat évite que "pièce" apparaisse pour tous les aliments à l'unité.
          const poidsPieceServeur = entree.tracking_type === 'unite' ? parseFloat(entree.poids_unite_g) : 0;
        %>
        <div class="journal-item carte-article" data-id="<%= entree.id %>" data-food-id="<%= entree.food_id %>" data-kcal="<%= entree.calories_calc %>" data-glucides="<%= entree.glucides_calc %>" data-proteines="<%= entree.proteines_calc %>" data-lipides="<%= entree.lipides_calc %>" data-emoji="<%= entree.emoji %>" data-g-cafe="<%= entree.grammes_par_cuil_a_cafe ?? '' %>" data-g-soupe="<%= entree.grammes_par_cuil_a_soupe ?? '' %>" data-poids-piece="<%= poidsPieceServeur || '' %>" data-unite-piece="<%= entree.unite_piece || '' %>" data-quantite-g="<%= parseFloat(entree.quantite_g) %>">
          <div class="reorder-controls">
            <button type="button" class="btn-reorder btn-reorder-haut" title="Monter" aria-label="Monter"></button>
            <button type="button" class="btn-reorder btn-reorder-bas" title="Descendre" aria-label="Descendre"></button>
          </div>
          <div class="journal-nom-groupe">
            <span class="journal-nom"><%= entree.emoji %> <%= entree.nom %></span>
            <span class="journal-categorie"><%= entree.categorie %></span>
          </div>
          <div class="journal-valeurs">
            <!-- Sélecteur d'unité toujours affiché (même juste "g") pour que chaque ligne garde la même forme. -->
            <div class="journal-quantite-groupe">
              <input type="number" class="journal-grammes-input" step="any" value="<%= parseFloat(entree.quantite_g) %>" min="0.25" />
              <select class="journal-unite-select">
                <option value="g">g</option>
                <% if (entree.grammes_par_cuil_a_cafe) { %><option value="cafe">tsp</option><% } %>
                <% if (entree.grammes_par_cuil_a_soupe) { %><option value="soupe">tbs</option><% } %>
                <% if (poidsPieceServeur) { %><option value="piece"><%= entree.unite_piece || 'pc' %></option><% } %>
              </select>
            </div>
            <span class="journal-kcal"><%= Number(entree.calories_calc).toFixed(0) %> kcal</span>
          </div>
          <form action="/calories/supprimer" method="post" class="form-supprimer-journal">
            <input type="hidden" name="idEntree" value="<%= entree.id %>" />
            <button type="submit" class="btn-supprimer-dash">Supprimer</button>
          </form>
        </div>
        <% }) %>
      </div>

      <p class="no-results hidden" id="noResultsJournal">Rien d'ajouté aujourd'hui.</p>
    </div>

    <!-- ============================================ -->
    <!-- ONGLET RECETTES -->
    <!-- ============================================ -->
    <div class="calories-tab-panel" data-panel="recettes">

      <% CATEGORIES_RECETTE.forEach(function(cat) { %>
      <section class="recette-groupe">
        <h3 class="recette-groupe-titre">
          <!-- Tri propre à cette section (voir appliquerTriGroupe dans calories.js) ; clic direct sur l'icône pour changer/inverser. -->
          <div class="recette-tri-icones">
            <button type="button" class="recette-tri-icone" data-critere="nom" title="Trier par nom">
              <img src="/images/svg/tri-alpha-asc.svg" alt="Trier par nom" />
            </button>
            <button type="button" class="recette-tri-icone" data-critere="kcal" title="Trier par calories">
              <img src="/images/svg/calorie-asc.svg" alt="Trier par calories" />
            </button>
          </div>
          <span class="recette-groupe-nom"><span class="icone-categorie-recette icone-categorie-recette--<%= cat.valeur %>"></span> <%= cat.label %></span>
          <!-- Grille/Liste propre à cette section, comme le tri (voir appliquerVueGroupe dans calories.js). -->
          <div class="recette-vue-icones">
            <button type="button" class="recette-vue-icone active" data-vue="grille" title="Vue grille"></button>
            <button type="button" class="recette-vue-icone" data-vue="liste" title="Vue liste"></button>
          </div>
        </h3>
        <div class="recette-grid" data-grid-cat="<%= cat.valeur %>">
          <% recettes.filter(function(r) { return r.categorie === cat.valeur; }).forEach(function(recette) { %>
          <div class="recette-card" data-id="<%= recette.id %>" data-cat="<%= recette.categorie %>" data-nom="<%= recette.nom.toLowerCase() %>" data-kcal="<%= recette.kcal_total %>" data-ingr="<%= recette.nb_ingredients %>">
            <!-- Pas de bouton éditer/supprimer ici : la carte ouvre le panneau de détail, seul endroit pour supprimer. -->
            <!-- 3 premiers émojis d'ingrédients comme icône ; repli sur l'icône de catégorie si aucun émoji. -->
            <% const emojisRecette = recette.emojis_ingredients.slice(0, 3).join(''); %>
            <span class="recette-emoji"><% if (emojisRecette) { %><%= emojisRecette %><% } else { %><span class="icone-categorie-recette icone-categorie-recette--<%= cat.valeur %>"></span><% } %></span>
            <div class="recette-corps">
              <p class="recette-nom"><%= recette.nom %></p>
              <div class="recette-sub"><span class="recette-ingr"><%= recette.nb_ingredients %> ingr.</span><span class="recette-kcal"><%= recette.kcal_total %> kcal</span></div>
            </div>
          </div>
          <% }) %>
          <div class="recette-card recette-new-card btn-nouvelle-recette" data-nouvelle-cat="<%= cat.valeur %>">
            <span class="recette-new-plus"></span>
            <span>Nouvelle recette</span>
          </div>
        </div>
      </section>
      <% }) %>
    </div>

  </div>
</main>

<!-- ============================================ -->
<!-- PANNEAU DÉTAIL D'UNE RECETTE (overlay, pas un onglet) -->
<!-- ============================================ -->
<div class="sheet-backdrop" id="sheetBackdrop"></div>
<div class="sheet" id="sheet">
  <div class="sheet-handle"></div>
  <form id="formRecette">
    <input type="hidden" id="recetteId" value="" />

    <div class="detail-header">
      <input type="text" id="recetteNom" class="detail-nom-edit" placeholder="Nom de la recette" required />
      <div class="detail-header-actions">
        <button type="button" id="sheetCloseBtn" class="sheet-close-btn" title="Fermer">✕</button>
      </div>
    </div>

    <!-- Le "+" ouvre/ferme la recherche d'ingrédient (repliée par défaut), même principe que Stock/Courses. -->
    <div class="detail-tag-row">
      <div class="detail-tag-select" id="recetteCategoriePicker">
        <button type="button" class="cat-pill actif" data-valeur="plat"><span class="icone-categorie-recette icone-categorie-recette--plat"></span> Plat</button>
        <button type="button" class="cat-pill" data-valeur="fraicheur"><span class="icone-categorie-recette icone-categorie-recette--fraicheur"></span> Fraîcheur</button>
      </div>
      <button type="button" id="btnToggleAjoutIngredient" class="btn-ajout-icone" title="Ajouter un ingrédient">Ajouter un ingrédient</button>
    </div>

    <div id="listeIngredientsRecette">
      <!-- Toujours le dernier enfant : chaque nouvel ingrédient s'insère juste avant (voir ajouterLigneIngredient dans calories.js). -->
      <div id="autocompleteIngredient" class="replie">
        <div class="champ-recherche-wrapper">
          <input type="text" id="rechercheIngredient" placeholder="Rechercher un aliment à ajouter..." autocomplete="off" />
          <button type="button" class="btn-effacer-recherche" data-cible="rechercheIngredient" aria-label="Effacer la recherche"></button>
        </div>
        <ul id="listeIngredientsRecherche">
          <% alimentsTries.forEach(function(aliment) { %>
          <% const poidsPieceLi = aliment.tracking_type === 'unite' ? parseFloat(aliment.poids_unite_g) : 0; %>
          <li data-id="<%= aliment.id %>" data-emoji="<%= aliment.emoji %>" data-g-cafe="<%= aliment.grammes_par_cuil_a_cafe ?? '' %>" data-g-soupe="<%= aliment.grammes_par_cuil_a_soupe ?? '' %>" data-poids-piece="<%= poidsPieceLi || '' %>" data-unite-piece="<%= aliment.unite || '' %>"><%= aliment.emoji %> <%= aliment.nom %></li>
          <% }) %>
        </ul>
      </div>
    </div>

    <p class="ingredients-vide" id="ingredientsVide">Aucun ingrédient pour l'instant — touche "+" pour en ajouter.</p>

    <button type="submit" id="btnEnregistrerSheet">Enregistrer</button>

    <!-- Séparé du "✕" fermer pour ne jamais déclencher cette action destructive par un tap malheureux ; masqué pour "Nouvelle recette" (voir calories.js). -->
    <button type="button" id="btnSupprimerRecetteSheet" class="btn-supprimer-pleine-largeur hidden">
      Supprimer
    </button>
  </form>
</div>

<script>
  // Copie des recettes côté client pour comparer au journal sans redemander au serveur (voir miseAJourBoutonEnregistrerRecette dans calories.js).
  window.RECETTES = <%- JSON.stringify(recettes) %>;
</script>
<script src="/js/calories.js" defer></script>

<%- include('partials/footer') %>
