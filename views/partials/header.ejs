<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <!-- maximum-scale=1 bloque le zoom auto iOS sur les champs <16px ; user-scalable=1 garde le pincer-zoomer manuel. -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=1" />
  <title>Chow — <%= title %></title>
  <!-- Favicon SVG inline (data URI) : source public/images/svg/icone-tab.svg, recolorée en --accent. -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cdefs%3E%3Cstyle%3E.cls-1%7Bfill:none;stroke:%23c8472b;stroke-miterlimit:10;stroke-width:1.91px;%7D%3C/style%3E%3C/defs%3E%3Cpath class='cls-1' d='M19.64,1.5H4.36L2.45,5.32V7.23a1.91,1.91,0,0,0,3.82,0,1.91,1.91,0,0,0,3.82,0,1.91,1.91,0,0,0,3.82,0,1.91,1.91,0,1,0,3.82,0,1.91,1.91,0,1,0,3.82,0V5.32Z'/%3E%3Cpath class='cls-1' d='M12,13.91h0a3.82,3.82,0,0,1,3.82,3.82v1a0,0,0,0,1,0,0H8.18a0,0,0,0,1,0,0v-1A3.82,3.82,0,0,1,12,13.91Z'/%3E%3Cline class='cls-1' x1='12' y1='12' x2='12' y2='13.91'/%3E%3Cline class='cls-1' x1='6.27' y1='18.68' x2='17.73' y2='18.68'/%3E%3Cline class='cls-1' x1='0.55' y1='22.5' x2='23.45' y2='22.5'/%3E%3Cline class='cls-1' x1='3.41' y1='8.18' x2='3.41' y2='22.5'/%3E%3Cline class='cls-1' x1='20.59' y1='8.18' x2='20.59' y2='22.5'/%3E%3Cline class='cls-1' x1='2.45' y1='5.32' x2='21.55' y2='5.32'/%3E%3Cline class='cls-1' x1='6.27' y1='5.32' x2='6.27' y2='7.23'/%3E%3Cline class='cls-1' x1='10.09' y1='5.32' x2='10.09' y2='7.23'/%3E%3Cline class='cls-1' x1='13.91' y1='5.32' x2='13.91' y2='7.23'/%3E%3Cline class='cls-1' x1='17.73' y1='5.32' x2='17.73' y2='7.23'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<header class="header">
  <div class="header__inner">
    <a href="/" class="logo">Chow</a>
    <!-- currentPath (middleware index.js) détermine quel lien reçoit la classe "actif" (voir .nav__link.actif). -->
    <nav class="nav">
      <a href="/aliments" class="nav__link <%= currentPath.startsWith('/aliments') ? 'actif' : '' %>">Aliments</a>
      <a href="/stock" class="nav__link <%= currentPath.startsWith('/stock') ? 'actif' : '' %>">Stock</a>
      <a href="/courses" class="nav__link <%= currentPath.startsWith('/courses') ? 'actif' : '' %>">Courses</a>
      <a href="/calories" class="nav__link <%= currentPath.startsWith('/calories') ? 'actif' : '' %>">Calories</a>
    </nav>
  </div>
</header>
<script>
  // Publie la vraie hauteur du header en variable CSS (--header-h) : elle varie selon l'écran, donc une valeur figée décalait .filters/.courses-controls-row au scroll.
  (function () {
    function publierHauteurHeader() {
      var header = document.querySelector(".header");
      if (header) {
        document.documentElement.style.setProperty("--header-h", header.offsetHeight + "px");
      }
    }
    publierHauteurHeader();
    window.addEventListener("resize", publierHauteurHeader);
  })();

  // Filet de sécurité Android : certains navigateurs zooment quand même au focus malgré maximum-scale ; on force un reset du zoom à la sortie du champ.
  (function () {
    var viewport = document.querySelector('meta[name="viewport"]');
    if (!viewport) return;
    var contenuNormal = viewport.getAttribute("content");

    document.addEventListener(
      "blur",
      function (event) {
        if (!event.target.matches("input, select, textarea")) return;
        viewport.setAttribute("content", contenuNormal + ", user-scalable=0");
        setTimeout(function () {
          viewport.setAttribute("content", contenuNormal);
        }, 300);
      },
      true // "blur" ne remonte pas (bubbles), il faut écouter en phase de capture
    );
  })();
</script>
